# Isolate volumes/network from any other local WordPress project.
COMPOSE_PROJECT_NAME=anotter-demo
HTTP_PORT=8080
SITE_URL=http://localhost:8080
# M05 security patch reviewed 2026-10-29; existing volumes require explicit core update.
WORDPRESS_IMAGE=wordpress:7.1.4-php8.3-apache
WPCLI_IMAGE=wordpress:cli-2.12.0-php8.3
MYSQL_IMAGE=mysql:8.4.13
WOOCOMMERCE_VERSION=11.2.1
# Official stable Mercado Pago release inspected on 2026-10-28.
MERCADOPAGO_VERSION=8.9.7
# Managed by dev.py tunnel / public-url; no credentials belong here.
PUBLIC_SITE_URL=
DB_NAME=anotter
DB_USER=anotter
# setup/init-env generates passwords and authentication keys when .env is absent.
# For a manual copy, fill ALL blank secrets with unique 24+ character values.
DB_PASSWORD=
DB_ROOT_PASSWORD=
WP_ADMIN_USER=demo_manager
WP_ADMIN_PASSWORD=
# Independent WordPress authentication keys/salts, generated by init-env.
WORDPRESS_AUTH_KEY=
WORDPRESS_SECURE_AUTH_KEY=
WORDPRESS_LOGGED_IN_KEY=
WORDPRESS_NONCE_KEY=
WORDPRESS_AUTH_SALT=
WORDPRESS_SECURE_AUTH_SALT=
WORDPRESS_LOGGED_IN_SALT=
WORDPRESS_NONCE_SALT=
WP_ADMIN_EMAIL=demo@example.invalid
# local enables WP debug logging to container stderr; staging/production disable it.
APP_ENV=local
# es_UY is used only if a translation is available for this WP release.
WP_LOCALE=es_UY
WP_FALLBACK_LOCALE=es_ES
# M01 legacy-zone default only. M03 samples: foundation/includes/demo-config.php.
DEMO_FLAT_RATE_COST=220
# Legacy M01 only. M03 disables COD and enables labelled offline BACS, never real payments.
DEMO_ENABLE_COD=no
